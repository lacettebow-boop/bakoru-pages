{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakuro-pages",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for client-side routes like /somename
    "not_found_handling": "single-page-application",
    // Only /api/* hits the Worker first; everything else is served as a static asset
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bakuro",
      // Replace after running: npx wrangler d1 create bakuro
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
  // R2 (uploads) is added in Phase 6, once the bucket exists.
}
